{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "description": "Lets your hive drive this browser: it opens its own tabs in a visible group and marks the page it controls.",
  "version": "0.4.0",
  "default_locale": "en",
  "homepage_url": "https://github.com/infinition/LaRuche",
  "incognito": "not_allowed",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "alarms",
    "debugger",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "optional_permissions": [
    "downloads",
    "offscreen",
    "scripting",
    "tabCapture"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_ext_name__",
    "default_icon": {
      "16": "icones/icon-16.png",
      "48": "icones/icon-48.png",
      "128": "icones/icon-128.png"
    }
  },
  "icons": {
    "16": "icones/icon-16.png",
    "48": "icones/icon-48.png",
    "128": "icones/icon-128.png"
  }
}
