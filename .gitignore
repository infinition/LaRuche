laruche/laruche-voix/src/*.egg-info/

# Eval run artifacts (JSONL per run) - keep evals/baseline.json tracked
laruche/evals/results/
# Nested standalone repo (window manager checkout)
laruche/le-wm/

# Eval scratch dir (created by controle_fichier mission)
laruche/eval_scratch/
# Windows shortcuts dropped in the repo
*.lnk

# Docs et code de travail internes (archivés hors dépôt, jamais publiés)
docs/_archive/
_archive/
