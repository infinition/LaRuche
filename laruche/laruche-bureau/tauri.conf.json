{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LaRuche",
  "version": "1.6.0",
  "identifier": "app.laruche.bureau",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": ["bin/*"],
    "shortDescription": "LaRuche",
    "longDescription": "LaRuche - votre ruche d'IA personnelle, entierement locale.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
