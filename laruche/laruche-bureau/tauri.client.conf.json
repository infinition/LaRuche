{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LaRuche Client",
  "version": "0.2.0",
  "identifier": "app.laruche.client",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "icon": [
      "icons-client/32x32.png",
      "icons-client/128x128.png",
      "icons-client/128x128@2x.png",
      "icons-client/icon.ico",
      "icons-client/icon.png"
    ],
    "resources": [],
    "shortDescription": "LaRuche Client",
    "longDescription": "Se connecte a une ruche existante du reseau local. N'embarque aucun noeud.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
